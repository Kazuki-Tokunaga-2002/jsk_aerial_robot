<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="delta" >

  <xacro:include filename="$(find delta)/urdf/module_20260809/delta_link.urdf.xacro" />
  <xacro:include filename="$(find delta)/urdf/common.xacro" />

  <xacro:arg name="module_visual_mesh_ext" default="dae" />
  <xacro:arg name="module_use_link_collision" default="true" />
  <xacro:property name="module_visual_mesh_ext" value="$(arg module_visual_mesh_ext)" />
  <xacro:property name="module_use_link_collision" value="$(arg module_use_link_collision)" />
  <xacro:property name="leg_length" value="0.207" />
  <xacro:property name="leg_radius" value="0.010" />
  <!-- wide foot contact for stable Gazebo landing -->
  <xacro:property name="foot_pad_radius" value="0.030" />
  <xacro:property name="foot_pad_thickness" value="0.006" />

  <xacro:delta_module self="1" child="2" rotor_direction="1" rotor_tilt="-0.2618" battery="0"/>
  <xacro:delta_module self="2" child="3" rotor_direction="-1" rotor_tilt="0.2618" battery="0"/>
  <xacro:delta_module self="3" child="4" rotor_direction="1" rotor_tilt="-0.2618"  battery="0"/>
  <xacro:delta_module self="4" child="4" rotor_direction="-1" rotor_tilt="0.2618" battery="0"/>

  <!-- dummy root link for KDL -->
  <link name="root">
    <xacro:virtual_inertial/>
  </link>
  <joint name="root_joint" type="fixed">
    <parent link="root"/>
    <child link="link1"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- flight controller -->
  <xacro:extra_module name="fc_link" parent="link2" visible="1" model_url="package://delta/urdf/mesh/module_20260809/fc.${module_visual_mesh_ext}">
    <origin xyz="0.1027 -0.0011 0.028061" rpy="0 0 0"/>
    <inertial>
      <origin xyz="0.028366953965133 0.00066511917988214 -0.0377809384933983" rpy="0 0 0"/>
      <mass value="0.111482914674144"/>
      <inertia
          ixx="2.47427758523878E-05" ixy="-8.62917751566855E-07" ixz="9.13593916073414E-08"
          iyy="4.19428417684218E-05" iyz="-2.09066344356501E-07"
          izz="6.46698168921048E-05"/>
    </inertial>
  </xacro:extra_module>

  <xacro:extra_module name="fc" parent="fc_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <xacro:virtual_inertial/>
  </xacro:extra_module>

  <!-- onboard computer: included in module_20260809 CAD mesh -->
  <!--
  <xacro:extra_module name="vim4" parent="link2" visible="1" model_url="package://delta/urdf/mesh/20240722/vim4.dae">
    <origin xyz="0.3635 0.01 0" rpy="${-pi/2} 0 0"/>
    <inertial>
      <origin xyz="0.00146548 0.00262274 0.01119251" rpy="0 0 0"/>
      <mass value="0.06613440"/>
      <inertia
          ixx="0.00001715" ixy="-0.00000087" ixz="0.00000023"
          iyy="0.00003523" iyz="0.00000039"
          izz="0.00004879"/>
    </inertial>
  </xacro:extra_module>
  -->

  <!-- vio sensor -->
  <xacro:extra_module name="lidar_imu_link" parent="link2" visible="1" model_url="package://delta/urdf/mesh/20240722/livox.dae" active="0">
    <origin xyz="0.3635 -0.01 0" rpy="0 ${pi/2} ${-pi/2}"/>
    <inertial>
      <mass value="0.27636213"/>
      <origin xyz="-0.00018920 -0.00000603 0.02463791" rpy="0 0 0"/>
      <inertia
          ixx="0.00014336" ixy="0.00000001" ixz="-0.00000005"
          iyy="0.00014607" iyz="0.00000003"  izz="0.00014571"/>
    </inertial>
  </xacro:extra_module>

  <!-- <xacro:extra_module name="lidar_imu" parent="lidar_imu_link"> -->
  <!--   <origin xyz="0 0 0.03905" rpy="0 0 0"/> -->
  <!--   <xacro:virtual_inertial/> -->
  <!-- </xacro:extra_module> -->

</robot>
